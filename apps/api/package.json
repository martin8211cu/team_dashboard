    "@team-dashboard/db": "workspace:*",
    "@team-dashboard/export": "workspace:*",
    "@team-dashboard/shared": "workspace:*",
    "hono": "^4.9.6",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^5.9.2"
  }
}
