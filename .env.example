PORT=8090
# URL pública del frontend (CORS + cookies). Sin barra final.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000

# Docker Compose (sin Postgres en el stack): URL pública del navegador hacia nginx
# WEB_PORT=8080
# WEB_ORIGIN=http://localhost:8080

# --- Web (Vite) — solo desarrollo local / build del frontend ---
# Proxy de `bun run dev:web` hacia la API (no hace falta en prod).
# VITE_DEV_API_URL=http://localhost:8090
# URL pública de la API embebida en el build del frontend (Coolify: build env).
# Vacío = mismo dominio que la web (/api vía reverse proxy).
# VITE_API_BASE_URL=https://api.example.com

# PostgreSQL (required). db:migrate creates the database from the URL path if missing.
DATABASE_URL=postgresql://user:pass@localhost:5432/team_dashboard
# DATABASE_ADMIN_DATABASE=postgres

# Auth (email + password). db:seed crea el miembro admin con estos valores.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_DEFAULT_PASSWORD=change-me-now
# AUTH_SESSION_DAYS=7
# AUTH_COOKIE_NAME=td_session
# AUTH_COOKIE_SECURE=true
# Si web y API están en dominios distintos: AUTH_COOKIE_SAME_SITE=none (requiere HTTPS)
# AUTH_COOKIE_SAME_SITE=lax

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# Team / Jira (prefer env over JSON file). If TEAM_PROJECT is set, file is ignored.
TEAM_PROJECT=DEMO
TEAM_MIN_SPRINT_NUMBER=1
TEAM_EPICS_SUMMARY_CONTAINS=Platform
TEAM_CYCLE_START_STATUS=To Do
TEAM_BLOCKED_STATUS=Blocked
TEAM_REFINEMENT_STATUS=In Progress
# TEAM_BOARD_ID=
# Legacy: TEAM_CONFIG_PATH=packages/shared/config/teams/example.json

# Worker (sprint sync cron)
WORKER_PORT=8091
SYNC_CRON=0 3 * * *
SYNC_SPRINT_DELAY_MS=60000
SYNC_CHANGELOG_CONCURRENCY=3
# SYNC_MAX_CLOSED_PER_RUN=5
SYNC_RUN_ON_START=false
