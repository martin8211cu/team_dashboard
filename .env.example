PORT=8090
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000

# PostgreSQL (required). db:migrate creates the database from the URL path if missing.
DATABASE_URL=postgresql://user:pass@localhost:5432/team_dashboard
# DATABASE_ADMIN_DATABASE=postgres

# Auth (email + password). db:seed crea el miembro admin con estos valores.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_DEFAULT_PASSWORD=change-me-now
# AUTH_SESSION_DAYS=7
# AUTH_COOKIE_NAME=td_session
# AUTH_COOKIE_SECURE=false

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# Optional: path to team JSON (default: packages/shared/config/teams/example.json)
# TEAM_CONFIG_PATH=

# Worker (sprint sync cron)
WORKER_PORT=8091
SYNC_CRON=0 3 * * *
SYNC_SPRINT_DELAY_MS=60000
SYNC_CHANGELOG_CONCURRENCY=3
# SYNC_MAX_CLOSED_PER_RUN=5
# SYNC_RUN_ON_START=false
